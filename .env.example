# LiteLLM 数据面
LITELLM_MASTER_KEY=sk-airlock-master-dev-only
LITELLM_PORT=4000

# 供应商密钥（P0/P1.1 至少填一个可用的）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
# Azure AI Foundry OpenAI 兼容端点（api_base 形如 https://<resource>.services.ai.azure.com/openai/v1）
AZURE_AI_API_BASE=
AZURE_AI_API_KEY=

# PostgreSQL
POSTGRES_USER=airlock
POSTGRES_PASSWORD=airlock_dev
POSTGRES_DB=airlock
POSTGRES_PORT=5432

# ClickHouse
CLICKHOUSE_USER=airlock
CLICKHOUSE_PASSWORD=airlock_dev
CLICKHOUSE_DB=airlock
CLICKHOUSE_PORT=9000

# Airlock Edge
EDGE_LISTEN_ADDR=:8080
EDGE_UPSTREAM_BASE_URL=http://localhost:4000
# 32 字节的 base64；生产环境必须替换
AIRLOCK_ENCRYPTION_KEY=YWlybG9jay1kZXYtb25seS0zMmJ5dGUta2V5ISEhISE=

# Airlock Control（管理面）
CONTROL_LISTEN_ADDR=:8081
OIDC_ISSUER=http://localhost:8000
OIDC_CLIENT_ID=airlock
OIDC_CLIENT_SECRET=airlock-dev-secret
OIDC_REDIRECT_URL=http://localhost:8081/auth/callback
# 首个平台管理员的 email 或 OIDC sub；系统内无管理员且此项为空时 control 拒绝启动
AIRLOCK_BOOTSTRAP_ADMIN=admin@example.com
# 离职对账周期
RECONCILE_INTERVAL=5m

# 审批流通知（本地用 Mailpit 收信，8025 端口有网页界面）
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_ADDR=localhost:1025
SMTP_FROM=airlock@example.com
# 审批 worker 的扫描周期
APPROVAL_WORKER_INTERVAL=30s
# 密钥维护循环：补做上游封禁、清理过期的轮换旧凭据
KEY_MAINTENANCE_INTERVAL=1m
