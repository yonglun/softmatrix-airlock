# Airlock 生产配置模板。
#
# install.sh 会以它为蓝本生成 .env，并**自动填入随机生成的**口令与加密
# 密钥（下面标了「安装时自动生成」的三项）。标了「必须人工填写」的几项
# 装完之后必须手工补齐，否则登录或模型调用会失败。

# ---- 版本（install.sh 从 VERSION 文件写入，不要手改）----
AIRLOCK_VERSION=

# ---- 安装时自动生成，不要手改 ----
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
# 32 字节的 base64。换掉它会导致所有已签发密钥无法解密。
AIRLOCK_ENCRYPTION_KEY=
LITELLM_MASTER_KEY=

# ---- 数据库基本信息 ----
POSTGRES_USER=airlock
POSTGRES_DB=airlock
CLICKHOUSE_USER=airlock
CLICKHOUSE_DB=airlock

# ---- 对外端口 ----
# 控制台与管理 API
CONTROL_PORT=8081
# 数据面：应用调用 AI 的入口
EDGE_PORT=8080
# 自带的身份提供方
CASDOOR_PORT=8000

# ---- 必须人工填写：身份认证 ----
# 浏览器能访问到的 Casdoor 地址，形如 http://airlock.example.com:8000
# 写 localhost 只在「就在这台机器上开浏览器」时可用。
CASDOOR_ORIGIN=http://localhost:8000
OIDC_ISSUER=http://localhost:8000
OIDC_CLIENT_ID=airlock
OIDC_CLIENT_SECRET=
# 必须与浏览器访问控制台的地址一致，形如 http://airlock.example.com:8081/auth/callback
OIDC_REDIRECT_URL=http://localhost:8081/auth/callback
# 首个平台管理员的 email 或 OIDC sub。
# 系统内无管理员且此项为空时，control 拒绝启动。
AIRLOCK_BOOTSTRAP_ADMIN=

# ---- 必须人工填写：上游模型供应商 ----
# 至少填一个，否则所有模型调用都会拿到上游 401。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# ---- 授权文件 ----
# 宿主机上 license 文件的绝对路径。留空则以试用模式运行（5 席位、不设到期）。
LICENSE_HOST_PATH=
# 容器内路径，与上面的挂载点对应。LICENSE_HOST_PATH 留空时这一项也要留空。
AIRLOCK_LICENSE_FILE=

# ---- 可选：邮件通知 ----
# 留空则不发信，审批仍可在控制台完成。填企业内网 relay，形如 smtp.example.com:25
SMTP_ADDR=
SMTP_FROM=airlock@example.com

# ---- 可选：LDAP 离职对账 ----
# 留空则不启用。
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
